# PostgreSQL connection used by the Flask API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# Secret used to sign admin session JWTs.
# Use a long random value in the real environment.
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth web application credentials.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.example.com/api/auth/google/callback

# Optional comma-separated Android OAuth client IDs accepted by the backend.
GOOGLE_ANDROID_CLIENT_IDS=your-android-client-id.apps.googleusercontent.com

# Optional: Flask CLI defaults for local development.
FLASK_APP=app.py
FLASK_ENV=development
